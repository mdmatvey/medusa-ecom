# ── VM ────────────────────────────────────────────────────────────────────────
# Your VM's public IP address (shown in deploy.sh output)
VM_IP=1.2.3.4

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=medusa-store
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── App secrets (generate with: openssl rand -hex 32) ─────────────────────────
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
COOKIE_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replace 1.2.3.4 with your actual VM IP
STORE_CORS=http://1.2.3.4
ADMIN_CORS=http://1.2.3.4:9000
AUTH_CORS=http://1.2.3.4,http://1.2.3.4:9000

# ── Storefront ────────────────────────────────────────────────────────────────
# URL the storefront uses to call Medusa API (baked in at build time)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://1.2.3.4:9000

# ── AWS S3 File Storage ───────────────────────────────────────────────────────
# S3_FILE_URL for AWS: https://s3.REGION.amazonaws.com/BUCKET_NAME
S3_FILE_URL=https://storage.yandexcloud.net/your-bucket-name
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
S3_REGION=ru-central1
S3_BUCKET=your-bucket-name
S3_PREFIX=uploads/
# For S3-compatible storage (Yandex, MinIO, DigitalOcean, etc.)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_FORCE_PATH_STYLE=false

# ── When you have a domain (future) ──────────────────────────────────────────
# DOMAIN=yourdomain.com
# CERTBOT_EMAIL=you@yourdomain.com
