# Nginx configuration — HTTP only (no domain required)
# Storefront: http://VM_IP  (port 80)
# API + Admin: http://VM_IP:9000  (exposed directly, not through nginx)
#
# When you have a domain and want HTTPS, replace this file with the
# contents of app.conf.https.template and run init-letsencrypt.sh.

server {
    listen 80;
    server_name _;

    client_max_body_size 50m;

    location / {
        proxy_pass         http://storefront:3000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
    }
}
