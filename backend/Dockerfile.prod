# Production Dockerfile for Medusa backend
# Multi-stage build: compiles the app, then runs from the lean .medusa/server output

# ── Build stage ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

COPY . .

# medusa build compiles everything to .medusa/server/
RUN npm run build

# ── Production stage ─────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Copy compiled server output
COPY --from=builder /build/.medusa/server ./

# Reuse node_modules from the builder — avoids a slow npm install on the VM
# on every deploy. Docker caches this layer until package.json changes.
COPY --from=builder /build/node_modules ./node_modules

EXPOSE 9000

# Migrations run only when MEDUSA_WORKER_MODE != "worker" (handled in compose via depends_on)
CMD ["npm", "run", "start"]
